# Скопируйте в .env и заполните. .env в git не попадает.

# Нагрузка на сайт: держите вежливо, чтобы не получить бан
PIPE_CONCURRENCY=5
PIPE_REQUESTS_PER_SECOND=2
PIPE_TIMEOUT_S=20
PIPE_MAX_RETRIES=4

# Прокси (если сайт режет по IP)
# PIPE_PROXY=http://user:pass@host:port

# Выход
PIPE_OUTPUT_DIR=output
PIPE_SQLITE_PATH=output/data.db
# PIPE_DATABASE_URL=postgresql://user:pass@localhost:5432/db

# Google Sheets (service account json + id таблицы, таблицу расшарить на email сервис-аккаунта)
# PIPE_GSHEETS_CREDENTIALS=secrets/service-account.json
# PIPE_GSHEETS_SPREADSHEET_ID=
